
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'nidit' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true


  pod 'FirebaseCore', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'niditTests' do
    inherit! :complete
    # Pods for testing
  end
end

# ⬇️ MOVER el post_install FUERA del target principal
post_install do |installer|
  installer.pods_project.targets.each do |target|
    # 🔥 Remover script de Hermes roto
    if target.name == 'hermes-engine'
      target.shell_script_build_phases.each do |phase|
        if phase.name.include?("Replace Hermes for the right configuration")
          puts "🧹 Removed broken Hermes script: {phase.name}"
          phase.remove_from_project
        end
      end
    end

    # ✅ Parche global para todos los targets que usan C++
    target.build_configurations.each do |config|
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= '$(inherited)'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] << ' -std=c++17'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] << ' -include folly/char_traits_unsigned_char_patch.h'

     if target.name == 'React-perflogger'
       config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
       config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/../node_modules/react-native/ReactCommon'
       config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/../node_modules/react-native/ReactCommon/reactperflogger'
       config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/../node_modules/react-native/ReactCommon/react/debug'
       config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/../node_modules/react-native/ReactCommon/yoga'
     end

      # 🛠 Fix extra para glog con Xcode >= 15
      if target.name == 'glog'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_SYS_TIME_H=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_STDINT_H=1'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_LIB_GFLAGS=1'
      end
    end
  end
end

